<Window x:Class="LandslideDesk.Win.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="280"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="MenuSurface" Color="#F6171C24" />
    <SolidColorBrush x:Key="MenuSurfaceHover" Color="#2733424F" />
    <SolidColorBrush x:Key="MenuText" Color="#F3F6FA" />
    <SolidColorBrush x:Key="MenuMuted" Color="#8FA1B5" />
    <SolidColorBrush x:Key="MenuLine" Color="#334152" />
    <DropShadowEffect x:Key="MenuShadow" BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.48" Color="#000000" />

    <Style x:Key="TrayMenuItem" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource MenuText}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource MenuSurfaceHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#4A454545" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="#6A22D3EE" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TrayDangerItem" TargetType="Button" BasedOn="{StaticResource TrayMenuItem}">
      <Setter Property="Foreground" Value="#FECACA" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#35DC2626" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#55DC2626" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="#F87171" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="5"
          Padding="6"
          CornerRadius="6"
          Background="{StaticResource MenuSurface}"
          BorderBrush="#4B5563"
          BorderThickness="1"
          Effect="{StaticResource MenuShadow}">
    <StackPanel>
      <Grid Height="30" Margin="8,0,8,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#34D399" />
        <TextBlock x:Name="HeaderStatus" Grid.Column="1" VerticalAlignment="Center" Foreground="#D1FAE5" FontSize="12" FontWeight="SemiBold" />
        <TextBlock x:Name="HeaderMeta" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MenuMuted}" FontSize="10.5" />
      </Grid>

      <Border Height="1" Margin="2,0,2,4" Background="{StaticResource MenuLine}" />

      <Button Style="{StaticResource TrayMenuItem}" Click="OnOpenMainClick">打开监测工作台</Button>
      <Button Style="{StaticResource TrayMenuItem}" Click="OnOpenSettingsClick">系统设置</Button>
      <Button Style="{StaticResource TrayMenuItem}" Click="OnReloadClick">重新加载页面</Button>
      <Button Style="{StaticResource TrayMenuItem}" Click="OnToggleFullscreenClick">
        <Grid HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
          <TextBlock Text="切换全屏" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="F11" Foreground="{StaticResource MenuMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Button>
      <Button Style="{StaticResource TrayMenuItem}" Click="OnOpenLogsClick">打开运行日志</Button>

      <Border Height="1" Margin="2,4" Background="{StaticResource MenuLine}" />

      <Button Style="{StaticResource TrayDangerItem}" Click="OnExitClick">退出应用</Button>
    </StackPanel>
  </Border>
</Window>

<Window x:Class="LandslideDesk.CustomBA.CustomInstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="山体滑坡监测桌面端 安装程序"
        Icon="pack://application:,,,/LandslideDesk.CustomBA;component/Assets/LandslideDesk.ico"
        Width="920" Height="580" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F8F9" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9EAFB5" />
        <SolidColorBrush x:Key="Accent" Color="#45D6AD" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B8C7CC" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#18FFFFFF" /><Setter Property="Foreground" Value="White" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#28FFFFFF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#071B17" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#64E2BD" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#30BD96" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#29453E" /><Setter Property="Foreground" Value="#708B84" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="Foreground" Value="#D7E2E5" />
            <Setter Property="BorderBrush" Value="#32FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1CFFFFFF" /><Setter TargetName="Surface" Property="BorderBrush" Value="#50FFFFFF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#08FFFFFF" /><Setter TargetName="Surface" Property="BorderBrush" Value="#18FFFFFF" /><Setter Property="Foreground" Value="#5C7076" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LaunchCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#C8D5D9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#0EFFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1">
                                <TextBlock x:Name="Mark" Text="✓" FontFamily="Segoe UI Symbol" FontSize="12" FontWeight="Bold" Foreground="#071B17" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" /><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" /><Setter TargetName="Mark" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#8AE7CE" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            CornerRadius="14"
            Background="#FF091820"
            BorderBrush="#36FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="RootSurface_OnMouseLeftButtonDown">
        <Border.Effect><DropShadowEffect BlurRadius="38" ShadowDepth="2" Direction="270" Color="#D0000000" Opacity="0.78" /></Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,894,554" RadiusX="13" RadiusY="13" />
            </Grid.Clip>
            <Grid.ColumnDefinitions><ColumnDefinition Width="322" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.Background>
                    <ImageBrush ImageSource="pack://application:,,,/LandslideDesk.CustomBA;component/Assets/landslide.png" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                </Grid.Background>
                <Rectangle Fill="#A9081D27" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#26153945" Offset="0" /><GradientStop Color="#E4091B22" Offset="1" /></LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid Margin="30,30,28,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/LandslideDesk.CustomBA;component/Assets/app-icon.png" Width="38" Height="38" Stretch="Uniform" />
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LANDSLIDE DESK" FontSize="11" FontWeight="SemiBold" Foreground="#8FE4CE" />
                            <TextBlock Margin="0,3,0,0" Text="部署中心" FontSize="11" Foreground="#AFC2C8" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="山体滑坡监测" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0" Text="桌面端" FontSize="28" FontWeight="SemiBold" />
                        <Border Width="44" Height="2" Margin="0,20,0,18" HorizontalAlignment="Left" Background="{StaticResource Accent}" />
                        <TextBlock Text="让现场数据、风险研判与预警处置&#x0a;在同一工作台完成。" FontSize="13" Foreground="#C4D2D6" LineHeight="23" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="WINDOWS  X64" FontSize="10" FontWeight="SemiBold" Foreground="#7FD6BF" />
                        <TextBlock Margin="0,7,0,0" Text="本地安装  ·  自动补齐运行环境" FontSize="11" Foreground="#AFC0C5" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" Background="#FA0A1820">
                <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="24,0,16,0" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" />
                        <TextBlock Margin="9,0,0,0" Text="安装程序" FontSize="12" Foreground="#9CB0B6" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource WindowButtonStyle}" Content="×" ToolTip="关闭" Click="CloseButton_OnClick" />
                </Grid>

                <Grid Grid.Row="1" Margin="46,30,44,30">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="准备安装" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0" Text="确认安装位置，随后将桌面端部署到当前设备。" FontSize="13" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,30,0,0">
                        <TextBlock Text="安装位置" FontSize="12" FontWeight="SemiBold" Foreground="#CAD7DA" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallFolderTextBox" Height="42" Padding="13,0" VerticalContentAlignment="Center" Background="#0DFFFFFF" Foreground="#EAF2F4" BorderBrush="#32FFFFFF" BorderThickness="1" FontFamily="Microsoft YaHei UI" FontSize="12" CaretBrush="{StaticResource Accent}" />
                            <Button x:Name="BrowseButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="42" MinWidth="86" Padding="12,0" Content="浏览" Click="BrowseButton_OnClick" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,25,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="安装进度" FontSize="12" FontWeight="SemiBold" Foreground="#CAD7DA" />
                            <TextBlock x:Name="ProgressText" Grid.Column="1" Text="0%" FontSize="11" Foreground="#65DDBD" />
                        </Grid>
                        <ProgressBar x:Name="OverallProgressBar" Margin="0,10,0,0" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Accent}" Background="#24FFFFFF" BorderThickness="0" />
                        <TextBlock x:Name="StatusText" Margin="0,12,0,0" MinHeight="40" Text="正在检测安装环境..." FontSize="12" Foreground="#AEBFC4" TextWrapping="Wrap" LineHeight="19" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="18" Height="18" CornerRadius="9" Background="#1E45D6AD" BorderBrush="#5A45D6AD" BorderThickness="1"><TextBlock Text="✓" FontFamily="Segoe UI Symbol" FontSize="10" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Grid.Column="1" Text="运行组件已随安装包提供；缺少 WebView2 时将自动补齐。" FontSize="11" Foreground="#81959B" VerticalAlignment="Center" />
                    </Grid>

                    <CheckBox x:Name="LaunchAfterInstallCheckBox" Grid.Row="4" Margin="0,20,0,0" Content="安装完成后启动桌面端" IsChecked="True" Style="{StaticResource LaunchCheckBoxStyle}" VerticalAlignment="Top" />

                    <Grid Grid.Row="5" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="UninstallButton" Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" MinWidth="112" Content="卸载现有版本" Click="UninstallButton_OnClick" />
                        <Button x:Name="FinishButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" MinWidth="94" Content="关闭" Click="FinishButton_OnClick" />
                        <Button x:Name="InstallButton" Grid.Column="4" Style="{StaticResource PrimaryButtonStyle}" Content="开始安装" Click="InstallButton_OnClick" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
